{
  "name": "dsh-workbench",
  "version": "0.0.1-poc.29",
  "private": true,
  "type": "module",
  "description": "DSH 部门研发工作台：Rust 团队服务端（SQLite/JWT/钉钉）、登录与首次引导、多迭代、多人会签、评审/排期/范围、设计/开发/测试/发布链路、技能管理、通知事件、右栏需求 + 内嵌设计画布。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.canvas.js",
    "canvas/*.js",
    "canvas/*.json",
    "canvas/gallery/*.js",
    "canvas/skills/**",
    "canvas/LICENSE",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check client.canvas.js",
    "test:bff": "node tests/host-bff.mjs",
    "pack:dry": "npm pack --dry-run"
  }
}
