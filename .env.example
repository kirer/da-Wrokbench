# 复制成 .env 后填入随机密钥（POSTGRES_PASSWORD / WORKBENCH_AUTH_SECRET / WORKBENCH_INTERNAL_TOKEN，
# 用 openssl rand -hex 32 生成），chmod 600 .env。本文件只说明各变量含义。
# POC 本地演示可保持 development + mock。
APP_ENV=development
WORKBENCH_PORT=3210

# Postgres（docker compose 使用；必须为随机值）
POSTGRES_PASSWORD=

# 认证：development 可用 mock；生产必须是 dingtalk。
WORKBENCH_AUTH_PROVIDER=mock
# 至少 32 字符随机值（openssl rand -hex 32）
WORKBENCH_AUTH_SECRET=
WORKBENCH_INTERNAL_TOKEN=
# 登录 JWT 有效期（秒），默认 7 天。
WORKBENCH_TOKEN_TTL_SECONDS=604800

# DSH host 插件与浏览器访问的团队服务端地址。
# 通过反向代理暴露 HTTPS 时填外部地址，例如 https://workbench.example.com
WORKBENCH_PUBLIC_URL=
# 浏览器跨域访问服务端时填写允许的 Origin（逗号分隔）；不填表示不启用 CORS。
WORKBENCH_ALLOWED_ORIGINS=
# 生产建议 1，让认证 Cookie 只走 HTTPS。
WORKBENCH_COOKIE_SECURE=

# 钉钉登录（WORKBENCH_AUTH_PROVIDER=dingtalk 时必填）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 钉钉应用 AgentId；开启工作通知时必填
DINGTALK_AGENT_ID=
DINGTALK_WORK_NOTIFY=0
DINGTALK_API_BASE=https://oapi.dingtalk.com
# 新版钉钉登录接口域名；测试时和 API_BASE 一起指向本地 mock。
DINGTALK_OAUTH_BASE=https://api.dingtalk.com
DINGTALK_DEFAULT_ROLES=dev
DINGTALK_SYNC_ROOT_DEPT=1
# 1 = 同步时停用钉钉中已不存在的成员；组织数据不完整时保持 0，避免误停用。
DINGTALK_SYNC_DISABLE_MISSING=0

# GitLab：Token 仅服务端读取，绝不下发浏览器
GITLAB_BASE_URL=
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
GITLAB_DEFAULT_BRANCH=main

# 日志级别
RUST_LOG=dsh_workbench_server=info,tower_http=info
