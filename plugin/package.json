{
  "name": "dsh-workbench",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "description": "DSH 部门研发工作台：Rust 团队服务端（SQLite/JWT/钉钉）、登录与首次引导、多项目与多迭代、多人会签、评审/排期/范围、设计/开发/测试/发布链路、技能管理、通知事件、全宽需求画布页 + 内嵌设计画布与按人会话。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**",
    "client.js",
    "client.canvas.js",
    "vendor/canvas/*.js",
    "vendor/canvas/gallery/*.js",
    "vendor/canvas/skills/**",
    "vendor/canvas/LICENSE",
    "vendor/canvas/SHA256SUMS",
    "vendor/canvas/PROVENANCE.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:client": "node build.mjs",
    "check": "node --check index.js && for f in lib/*.js; do node --check \"$f\" || exit 1; done && node --check client.js && node --check client.canvas.js",
    "test:unit": "node --test ../tests/bff-unit.mjs",
    "test:bff": "node ../tests/host-bff.mjs",
    "reset:test-data": "bash ../tools/reset-workbench-test-data.sh",
    "pack:dry": "npm pack --dry-run"
  }
}
